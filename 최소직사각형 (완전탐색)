class Solution {
    public int solution(int[][] sizes) {
        int answer = 0;
        int maxWidth = 0;
        int maxHeight = 0;
        
        for (int[] size : sizes) {
            int w = Math.max(size[0], size[1]);  // 큰 값을 가로로
            int h = Math.min(size[0], size[1]);  // 작은 값을 세로로
            
            maxWidth = Math.max(maxWidth, w);
            maxHeight = Math.max(maxHeight, h);
        }
        
        answer = maxWidth * maxHeight;
        
        return answer;
    }
}
