class Solution {
    public int solution(int m, int n, int[][] puddles) {
        // dp[y][x] : (x, y) 좌표까지 오는 경로의 수
        // 1-indexed로 쓰기 위해 크기를 (n+1) x (m+1)로 잡음
        long[][] dp = new long[n + 1][m + 1];
        final int MOD = 1_000_000_007;

        // 물웅덩이 표시용 Set (좌표를 문자열이나 2차원 배열로 체크)
        boolean[][] isPuddle = new boolean[n + 1][m + 1];
        for (int[] p : puddles) {
            isPuddle[p[1]][p[0]] = true;  // p[0]=x, p[1]=y
        }

        dp[1][1] = 1;  // 시작점

        for (int y = 1; y <= n; y++) {
            for (int x = 1; x <= m; x++) {
                if (x == 1 && y == 1) continue;  // 시작점은 이미 처리함

                if (isPuddle[y][x]) {
                    dp[y][x] = 0;  // 웅덩이는 지나갈 수 없음
                    continue;
                }

                long fromLeft = (x > 1) ? dp[y][x - 1] : 0;
                long fromUp = (y > 1) ? dp[y - 1][x] : 0;

                dp[y][x] = (fromLeft + fromUp) % MOD;
            }
        }

        return (int) dp[n][m];
    }
}
